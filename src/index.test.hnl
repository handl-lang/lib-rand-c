--- rand-c tests — the `seeded_*` family is pure handl (a deterministic
--- `(seed, k)` hash PRNG, no FFI), so it is fully testable here. The
--- unseeded arrows draw from libsodium via `entropy.next_u32` and are
--- not exercised (they need the C host).

from "./index" import * as m

-- hash(1, 0) = mod(1*12345 + 0*6789, 2147483647) = 12345

test_seeded_int := assert m.seeded_int(1, 10) == 3

test_seeded_int_zero_max := assert m.seeded_int(1, 0) == 0

test_seeded_bool := assert m.seeded_bool(1) == false

test_seeded_pick := assert m.seeded_pick(1, [10, 20, 30]) == 10

-- seeded_choice draws with replacement: k=0 -> i = 12345 % 3 = 0,
-- k=1 -> i = 19134 % 3 = 0
test_seeded_choice := assert m.seeded_choice(1, [1, 2, 3], 2) == [1, 1]

-- seeded_sample removes picks: k=0 -> xs[0]=1, k=1 -> 19134 % 2 = 0 -> 2
test_seeded_sample := assert m.seeded_sample(1, [1, 2, 3], 2) == [1, 2]

test_seeded_sample_empty := assert m.seeded_sample(1, [], 3) == []

-- seeded_shuffle = seeded_sample over the whole list
test_seeded_shuffle := assert m.seeded_shuffle(1, [1, 2, 3]) == [1, 2, 3]

-- seeded_string: charset index = hash % 3 = 0 for k = 0,1,2 -> "aaa"
test_seeded_string := assert m.seeded_string(1, 3, "abc") == "aaa"

test_seeded_string_empty := assert m.seeded_string(1, 0, "abc") == ""

-- determinism: same seed -> same value
test_seeded_deterministic := assert m.seeded_int(7, 100) == m.seeded_int(7, 100)

test_seeded_differs := assert m.seeded_int(1, 100) != m.seeded_int(2, 100)
